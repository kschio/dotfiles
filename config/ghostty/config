shell-integration = fish
shell-integration-features = cursor, sudo, title

# Background
background-opacity = 0.85
background-blur-radius = 40

# Font settings
font-family = "TX-02 SemiCondensed"
font-thicken = false
font-size = 14

# Base colors
# background = #111111
# foreground = #eeeeee

# Terminal colors (ANSI)
# palette = 0=#4f4f4f
# palette = 1=#fa6c60
# palette = 2=#a8ff60
# palette = 3=#fffeb7
# palette = 4=#96cafe
# palette = 5=#fa73fd
# palette = 6=#c6c5fe
# palette = 7=#efedef
# palette = 8=#7b7b7b
# palette = 9=#fcb6b0
# palette = 10=#cfffab
# palette = 11=#ffffcc
# palette = 12=#b5dcff
# palette = 13=#fb9cfe
# palette = 14=#e0e0fe
# palette = 15=#ffffff


# Selection and cursor
# selection-background = #0090ff
# selection-foreground = #eeeeee
# cursor-color = #0090ff
cursor-style = block

# Theme
theme = light:oxocarbon-light,dark:Oxocarbon

# Window padding
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# Cell adjustments
adjust-cell-height = 2%

# Mouse settings
mouse-hide-while-typing = true
mouse-scroll-multiplier = 6

# Window state
window-save-state = always

# Text Behavior
macos-option-as-alt = true
keybind = cmd+right=text:\x05
keybind = cmd+left=text:\x01
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = alt+left=unbind
keybind = alt+right=unbind

# MacOS
macos-titlebar-style = tabs
macos-option-as-alt = true

keybind = shift+enter=text:\n

# Ghostty → tmux bridge (send escape sequences for tmux M- bindings)
keybind = super+physical:one=unbind
keybind = super+physical:two=unbind
keybind = super+physical:three=unbind
keybind = super+physical:grave_accent=text:\x1b`
keybind = super+physical:one=text:\x1b1
keybind = super+physical:two=text:\x1b2
keybind = super+physical:three=text:\x1b3
keybind = super+alt+physical:one=text:\x1b!
keybind = super+alt+physical:two=text:\x1b@
keybind = super+shift+k=text:\x1bK
keybind = super+f=write_screen_file:open
keybind = f18=text:\x1bm

# Custom shaders
custom-shader = shaders/blaze.glsl
custom-shader-animation = true
